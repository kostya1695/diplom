flowchart LR
    %% ===== User / Frontend lane =====
    subgraph U["Пользователь / Frontend"]
        direction TB
        U1["Вход в систему"]
        U2["Доступ к системе разрешён"]
        U3["Выбор файла для загрузки"]
        U4["Отправка файла на сервер"]
        U5["Отправка документа на регистрацию"]
        U6["Запрос проверки документа"]
        U7["Получение результата проверки"]
    end

    %% ===== Backend API lane =====
    subgraph B["Backend API"]
        direction TB
        B1["Проверка данных пользователя"]
        B3["Проверка файла"]
        B2{"Файл прошёл<br/>проверку?"}
        B4["Вычисление SHA-256 hash"]
        B5["Формирование метаданных документа"]
        B6["Создание записи о документе"]
        B7{"Документ отправляется<br/>в блокчейн?"}
        B8["Изменение статуса документа"]
        B9["Подготовка транзакции<br/>для блокчейна"]
        B10["Обработка ответа от blockchain"]
        B11["Повторный расчёт hash<br/>при проверке"]
        B12["Сравнение hash"]
        B13["Формирование результата:<br/>VERIFIED / NOT VERIFIED"]
        BERR["Сообщение об ошибке"]
        BOFF["Документ остаётся off-chain"]
        BEND((Завершение процесса))
    end

    %% ===== File storage lane =====
    subgraph S["Файловое хранилище"]
        direction TB
        S1["Сохранение файла off-chain"]
        S2["Возврат storage_key / пути к файлу"]
    end

    %% ===== Database lane =====
    subgraph D["База данных"]
        direction TB
        D1["Сохранение метаданных документа"]
        D2["Сохранение hash"]
        D3["Сохранение статуса: UPLOADED"]
        D4["Сохранение статуса: PENDING_REGISTRATION"]
        D5["Сохранение tx_hash"]
        D6["Сохранение blockchain_object_id"]
        D7["Обновление статуса: REGISTERED"]
        D8["Чтение документа по hash"]
        D9["Возврат данных о документе"]
        D10["Сохранение статуса:<br/>VERIFIED / NOT VERIFIED"]
    end

    %% ===== Blockchain lane =====
    subgraph C["Blockchain / Smart Contract"]
        direction TB
        C1["Регистрация документа в блокчейне"]
        C2["Вызов метода registerObject(...)"]
        C3["Фиксация hash, owner, metadata"]
        C4["Возврат tx_hash"]
    end

    %% ===== Stage 1: Authentication =====
    U1 -- auth request --> B1
    B1 --> U2

    %% ===== Stage 2: File upload =====
    U2 --> U3
    U3 --> U4
    U4 -- file upload --> B3
    B3 --> B2
    B2 -- Нет --> BERR
    BERR --> BEND
    B2 -- Да --> B4
    B4 --> B5
    B5 --> B6
    B5 -- save file --> S1
    S1 --> S2
    B6 -- hash + metadata --> D1
    D1 --> D2
    D2 --> D3
    D3 -- save status --> B7

    %% ===== Stage 3: Blockchain registration decision =====
    B7 -- Нет --> BOFF
    BOFF --> U6
    B7 -- Да --> U5
    U5 --> B8
    B8 --> B9
    B9 --> D4
    D4 --> C1
    C1 -- registerObject() --> C2
    C2 --> C3
    C3 --> C4
    C4 -- tx_hash --> B10
    B10 --> D5
    D5 --> D6
    D6 --> D7
    D7 --> U6

    %% ===== Stage 4: Document verification =====
    U6 -- verify request --> B11
    B11 --> B12
    B12 --> D8
    D8 --> D9
    D9 --> B13
    B13 -- result --> D10
    D10 --> U7

    classDef user fill:#E3F2FD,stroke:#1E88E5,color:#0D47A1,stroke-width:1.5px;
    classDef backend fill:#FFF8E1,stroke:#FB8C00,color:#E65100,stroke-width:1.5px;
    classDef storage fill:#E8F5E9,stroke:#43A047,color:#1B5E20,stroke-width:1.5px;
    classDef db fill:#F3E5F5,stroke:#8E24AA,color:#4A148C,stroke-width:1.5px;
    classDef chain fill:#FBE9E7,stroke:#F4511E,color:#BF360C,stroke-width:1.5px;
    classDef decision fill:#FFF3E0,stroke:#EF6C00,color:#5D4037,stroke-width:2px;
    classDef endStyle fill:#FFEBEE,stroke:#C62828,color:#B71C1C,stroke-width:2px;

    class U1,U2,U3,U4,U5,U6,U7 user;
    class B1,B3,B4,B5,B6,B8,B9,B10,B11,B12,B13,BERR,BOFF backend;
    class B2,B7 decision;
    class BEND endStyle;
    class S1,S2 storage;
    class D1,D2,D3,D4,D5,D6,D7,D8,D9,D10 db;
    class C1,C2,C3,C4 chain;
